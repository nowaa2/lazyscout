{
  "name": "lazyscout",
  "version": "0.3.1",
  "description": "Local-first QA assistant for website exploration, test-case drafting, and Playwright/Cypress automation code generation.",
  "type": "module",
  "license": "MIT",
  "author": "nowzaa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nowaa2/lazyscout.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/nowaa2/lazyscout#readme",
  "bugs": {
    "url": "https://github.com/nowaa2/lazyscout/issues"
  },
  "bin": {
    "lazyscout": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "qa",
    "testing",
    "test-case",
    "playwright",
    "cypress",
    "crawler",
    "automation",
    "quality-assurance",
    "testing-tools",
    "software-tester",
    "csv"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "cd ../.. && npm run check:secrets && npm run build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.6.1",
    "playwright-core": "^1.56.1"
  },
  "devDependencies": {
    "@lazyscout/core": "*",
    "@lazyscout/explorer": "*",
    "@lazyscout/generators": "*",
    "@lazyscout/server": "*",
    "@lazyscout/web": "*",
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3"
  }
}
