{
  "name": "lazyscout",
  "version": "0.1.0",
  "description": "วิเคราะห์เว็บไซต์ด้วย Playwright แล้วสร้าง Draft Test Case + Test Data ให้ Software Tester พร้อม export CSV — ทำงานในเครื่องตัวเอง ไม่ต้องสมัครสมาชิก",
  "type": "module",
  "license": "MIT",
  "bin": {
    "lazyscout": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "qa",
    "testing",
    "test-case",
    "playwright",
    "crawler",
    "automation",
    "software-tester",
    "csv"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "cd ../.. && npm run build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.1",
    "playwright-core": "^1.56.1"
  },
  "devDependencies": {
    "@lazyscout/core": "*",
    "@lazyscout/explorer": "*",
    "@lazyscout/generators": "*",
    "@lazyscout/server": "*",
    "@lazyscout/web": "*",
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3"
  }
}
