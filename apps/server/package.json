{
  "name": "@lazyscout/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "typecheck": "tsc -b --force"
  },
  "dependencies": {
    "@lazyscout/core": "*",
    "@lazyscout/explorer": "*",
    "@lazyscout/generators": "*",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.20.6"
  }
}
