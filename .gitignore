node_modules/
dist/
*.tgz
*.tsbuildinfo

# Throwaway scripts and dumps written while verifying a change.
# See CLAUDE.md — scratch work belongs outside the repo, but when it has to
# live here to resolve workspace imports, name it so it cannot be committed.
scratch-*
*.scratch.*
*-tmp.mjs
*-probe.mjs
probe*.mjs

# Temp run directories the Playwright runner creates next to its CLI entry.
.lazyscout-run-*

# Test files stay local and are never committed — this repository keeps them
# out of Git by owner's decision. They still run: the files live on the
# developer's disk and `npm test` picks them up, they are simply untracked.
# A fresh clone therefore has no test suite, which is why `npm test` passes
# with no test files rather than failing.
**/*.test.ts
**/*.spec.ts
**/test.ts
**/tests-output/
**/generated-tests/
recordings/

.env
.env.*
!.env.example

*.db
*.sqlite
*.sqlite3

workspace/
LazyScout/
local-data/
user-data/
sessions/
# Saved authentication artifacts. Source directories named auth/ are code,
# not artifacts, so they are re-included below.
auth/
!apps/*/src/auth/
!apps/*/src/auth/**
!packages/*/src/auth/
!packages/*/src/auth/**
storage-state/
storageState.json

coverage/
playwright-report/
test-results/
traces/
videos/
screenshots/
!apps/site/public/screenshots/
!apps/site/public/screenshots/**
har/
*.har

.cache/
.wrangler/
.DS_Store
Thumbs.db
