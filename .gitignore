node_modules/
dist/
*.tgz
*.tsbuildinfo

# Throwaway scripts and dumps written while verifying a change.
# See CLAUDE.md — scratch work belongs outside the repo, but when it has to
# live here to resolve workspace imports, name it so it cannot be committed.
scratch-*
*.scratch.*
*-tmp.mjs
*-probe.mjs
probe*.mjs

# Temp run directories the Playwright runner creates next to its CLI entry.
.lazyscout-run-*

# Test code generated by LazyScout into a scouted repository.
# The project's own unit tests live in packages/*/tests and are re-included below.
**/*.test.ts
!packages/*/tests/**/*.test.ts
!apps/*/tests/**/*.test.ts
**/*.spec.ts
**/test.ts
**/tests-output/
**/generated-tests/
recordings/

.env
.env.*
!.env.example

